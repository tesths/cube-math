# ============================================================
# cube-math（正方体三视图）环境变量示例
# 复制成 .env（本地用）或在平台控制台里逐条填（Vercel / Railway）
# 真值不要提交到 Git（.env 已在 .gitignore 里）
# ============================================================

# ---------- 本地 / Railway / 自己的服务器 ----------
PORT=5173
# HOST=0.0.0.0
# 文件存储写在哪里（Railway 要挂 Volume，一般用 /data）
DATA_DIR=./data

# 前后端分开部署时（前端在 Vercel、后端在 Railway），允许浏览器跨域访问后端的来源。
# 生产环境建议写成前端的域名，例如 https://cube.dididigu.com；
# 本地调试或图省事时用 *（后端只存课堂数据，风险可接受）。
CORS_ORIGIN=*

# ---------- Vercel 无服务器：必须配 Redis ----------
# Vercel 没有可写磁盘、函数实例之间也不共享内存，10 个组要互相同步只能靠 Redis。
# 免费额度足够一个班用：Upstash 免费版（Vercel Marketplace 里一键装）。
#
# 两套变量名都支持，配其中一套即可：
#
#   A) 直接用 Upstash 控制台的值
#      UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
#      UPSTASH_REDIS_REST_TOKEN=AXxxxx
#
#   B) Vercel Marketplace / 旧版 Vercel KV 自动注入的值
#      KV_REST_API_URL=https://xxx.upstash.io
#      KV_REST_API_TOKEN=AXxxxx
#
# 注意：KV_REST_API_READ_ONLY_TOKEN 是只读令牌，写不进去，别拿它当 TOKEN。
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Redis 单次请求超时（毫秒）。不填默认 3000。
# 函数 maxDuration 是 10 秒，3 秒足够；Redis 超时不会报错，会自动降级为内存存储。
# REDIS_TIMEOUT_MS=3000